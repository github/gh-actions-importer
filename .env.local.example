# Example environment variables for GitHub Actions Importer
# Copy this file to .env.local and fill in your credentials

# ===== GITHUB CONFIGURATION (REQUIRED) =====
GITHUB_ACCESS_TOKEN=ghp_your_personal_access_token_here
# GITHUB_INSTANCE_URL=https://github.com  # Defaults to github.com

# ===== OLLAMA CONFIGURATION (FOR AI-ASSISTED MIGRATION) =====
OLLAMA_API_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# ===== CI/CD PLATFORM CREDENTIALS =====
# Uncomment and fill in only the platforms you're migrating FROM

# --- Azure DevOps ---
# AZURE_DEVOPS_ACCESS_TOKEN=your_token_here
# AZURE_DEVOPS_INSTANCE_URL=https://dev.azure.com
# AZURE_DEVOPS_ORGANIZATION=your_org
# AZURE_DEVOPS_PROJECT=your_project

# --- Bamboo ---
# BAMBOO_ACCESS_TOKEN=your_token_here
# BAMBOO_INSTANCE_URL=https://bamboo.example.com

# --- Bitbucket ---
# BITBUCKET_ACCESS_TOKEN=your_token_here

# --- CircleCI ---
# CIRCLE_CI_ACCESS_TOKEN=your_token_here
# CIRCLE_CI_INSTANCE_URL=https://circleci.com
# CIRCLE_CI_ORGANIZATION=your_org

# --- GitLab ---
# GITLAB_ACCESS_TOKEN=your_private_token_here
# GITLAB_INSTANCE_URL=https://gitlab.com

# --- Jenkins ---
# JENKINS_ACCESS_TOKEN=your_token_here
# JENKINS_USERNAME=your_username
# JENKINS_INSTANCE_URL=https://jenkins.example.com

# --- Travis CI ---
# TRAVIS_CI_ACCESS_TOKEN=your_token_here
# TRAVIS_CI_INSTANCE_URL=https://travis-ci.com
# TRAVIS_CI_ORGANIZATION=your_org

# ===== OPTIONAL CONFIGURATION =====
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
# YAML_VERBOSITY=trace  # Options: trace, debug, info, warn, error
# INSTALLATION_TYPE=container  # Set to 'container' for Docker-based execution
